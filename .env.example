# Bale Bot Token (required)
BALE_TOKEN=your_bale_bot_token_here

# Telegram Bot Token (optional — for TG ↔ Bale sync)
TG_TOKEN=your_telegram_bot_token_here

# Local Telegram Bot API Server URL (optional — removes 20MB download limit, up to 2GB)
# Example: http://localhost:8081
# TG_API_URL=http://localhost:8081

# Web server settings
WEB_HOST=0.0.0.0
WEB_PORT=8080

# Downloads directory
DOWNLOAD_DIR=/tmp/bale-bot-downloads

# User mapping: Telegram User ID -> Bale User ID
# Format: JSON string
USER_MAPPING={"123456789": "987654321"}

# Or use individual env vars:
# TG_BALE_USER_123456789=987654321

# Allowed Bale users (comma-separated, empty = allow all)
# ALLOWED_USERS=12345,67890
